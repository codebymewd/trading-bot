//+------------------------------------------------------------------+
//| TestTrendBotComm.mq5 - self-test for the EA's backend layer      |
//| Checks SHA-256, HMAC (standard + backend vectors), the JSON      |
//| parser, config mapping/validation on a REAL backend response,    |
//| and the event queue. Run it from Navigator > Scripts.            |
//| Expected last line in the Experts tab:  "ALL PASSED"             |
//+------------------------------------------------------------------+
#property strict
#include <TrendBot/TrendBotComm.mqh>
#include <TrendBot/TrendBotRuntime.mqh>
#include <TrendBot/TrendBotSampleConfig.mqh>

int g_fail = 0;

void Check(const bool ok, const string name)
  {
   if(!ok) { g_fail++; Print("FAIL: ", name); }
  }

void CheckS(const string got, const string want, const string name)
  {
   if(got != want) { g_fail++; Print("FAIL: ", name, "  got [", got, "] want [", want, "]"); }
  }

void OnStart()
  {
   // ---- hashing and HMAC
   CheckS(TB_Sha256Hex("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256(abc)");
   CheckS(TB_Sha256Hex(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256(empty)");
   CheckS(TB_HmacHex("Jefe", "what do ya want for nothing?"),
          "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "HMAC RFC4231 case 2");
   uchar longKey[], msg[], out[];
   ArrayResize(longKey, 131);
   for(int i = 0; i < 131; i++) longKey[i] = 0xaa;
   TB_ToBytes("Test Using Larger Than Block-Size Key - Hash Key First", msg);
   TB_HmacSha256(longKey, msg, out);
   CheckS(TB_Hex(out), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54", "HMAC RFC4231 case 6 (key longer than block)");
   string secret32 = "";
   for(int i = 0; i < 32; i++) secret32 += "x";
   string signedMsg = TB_SignMessage("POST", "/ea/heartbeat", "1700000000", "abc123", "{\"a\":1}");
   CheckS(TB_HmacHex(secret32, signedMsg), "370f139c739191feba7bff31ddddb2de20508e87d72d03f7bc5c783ee272d632",
          "backend signing vector (docs/DEPLOYMENT.md)");

   // ---- JSON parser
   TB_Json j;
   Check(j.Parse("{\"a\":1,\"b\":[true,false,null,\"x\\\"y\\n\"],\"c\":{\"d\":-2.5e1,\"e\":\"\\u0041\"}} "), "parse sample: " + j.err);
   Check(j.Num(j.Path("a")) == 1.0, "a == 1");
   Check(j.Count(j.Path("b")) == 4, "array length");
   Check(j.Bool(j.At(j.Path("b"), 0)) && !j.Bool(j.At(j.Path("b"), 1)), "bools");
   Check(j.t[j.At(j.Path("b"), 2)] == TBJ_NULL, "null");
   CheckS(j.Str(j.At(j.Path("b"), 3)), "x\"y\n", "string escapes");
   Check(j.Num(j.Path("c.d")) == -25.0, "number with exponent");
   CheckS(j.Str(j.Path("c.e")), "A", "unicode escape");
   Check(j.Path("c.missing") < 0 && j.Path("zzz") < 0, "missing paths");
   Check(j.HasString(j.Path("b"), "x\"y\n"), "HasString");
   TB_Json bad;
   Check(!bad.Parse("{\"a\":}"), "reject missing value");
   Check(!bad.Parse("{\"a\":1"), "reject unterminated object");
   Check(!bad.Parse("{\"a\":1} garbage"), "reject trailing characters");
   Check(!bad.Parse("[1,2,"), "reject unterminated array");
   Check(!bad.Parse("{\"a\":\"unterminated}"), "reject unterminated string");

   // ---- a REAL backend heartbeat response (generated by tools/gen_sample_config.py)
   string resp = TB_SampleResponse();
   TB_Json r;
   Check(r.Parse(resp), "parse sample response: " + r.err);
   Check(r.Count(r.Path("commands")) == 1, "one command in the sample");
   CheckS(r.Str(r.Member(r.At(r.Path("commands"), 0), "kind")), "PAUSE", "command kind");
   TB_Runtime rt;
   string err;
   Check(TB_RuntimeFromJson(r, "config.", rt, err), "map config: " + err);
   Check(TB_RuntimeValidate(rt, r, "config.", err), "validate config: " + err);
   CheckS(rt.core.mode, "SIGNAL_ONLY", "mode");
   Check(rt.core.risk_percent == 1.0 && rt.core.max_open_risk_percent == 1.0 && rt.core.max_positions == 1, "risk defaults");
   Check(rt.core.target_multiplier == 3.0 && rt.core.scalp_window_minutes == 15, "target + window defaults");
   CheckS(rt.core.timeout_action, "CLOSE_ALL", "timeout action");
   CheckS(rt.core.htf_mode, "H4_AND_D1", "htf mode");
   CheckS(rt.core.entry_mode, "market_confirmed", "entry mode");
   Check(rt.core.setup_tf == "M15" && rt.core.execution_tf == "M5", "timeframes");
   Check(rt.core.reset_utc_offset_seconds == 3600 && rt.core.reset_minutes == 0, "Lagos reset");
   Check(rt.core.enabled_indicator_count == 4 && rt.core.min_confirmations == 3, "indicator counts");
   Check(rt.scalp.enabled[0] && rt.scalp.enabled[1] && rt.scalp.enabled[2] && rt.scalp.enabled[3] && !rt.scalp.enabled[4], "indicator flags (CCI off)");
   Check(rt.scalp.setup_tf_seconds == 900 && rt.scalp.trigger_tf_seconds == 300, "tf seconds");
   Check(rt.scalp.fvg_setup && rt.scalp.sweep_setup && rt.scalp.require_bos_linked_fvg && !rt.scalp.gate_h4_only, "setup flags");
   Check(rt.scalp.trigger_window_bars == 12 && rt.scalp.zone_max_age_bars == 24, "windows");
   Check(rt.scalp.ind.rsi_period == 14 && rt.scalp.ind.macd_slow == 26 && rt.scalp.ind.bb_period == 20, "indicator params");
   Check(rt.config_version == 1 && StringLen(rt.config_hash) == 64, "version + hash");
   Check(rt.heartbeat_seconds == 10 && rt.stale_config_seconds == 300 && !rt.kill_switch, "safety block");
   Check(rt.n_logins == 1 && rt.allowed_logins[0] == 555001 && TB_AccountAllowed(rt, 555001) && !TB_AccountAllowed(rt, 1), "allowed logins");
   Check(rt.be_method == "off" && rt.max_consecutive_losses == 0 && rt.daily_loss_limit_percent == 0.0, "null fields mean none");
   Check(!rt.news_high_allow && rt.news_medium_allow && rt.news_low_allow && rt.news_on_missing == "block", "news policy");
   Check(rt.vol_allow_normal && rt.vol_allow_elevated, "volatility states");

   // ---- the EA must refuse bad configurations (independent validation)
   string cases[][3];
   ArrayResize(cases, 7);
   cases[0][0] = "\"mode\":\"SIGNAL_ONLY\"";          cases[0][1] = "\"mode\":\"LIVE\"";             cases[0][2] = "LIVE refused";
   cases[1][0] = "\"risk_percent\":1.0";              cases[1][1] = "\"risk_percent\":0.0";          cases[1][2] = "zero risk refused";
   cases[2][0] = "\"target_multiplier\":3.0";         cases[2][1] = "\"target_multiplier\":99.0";    cases[2][2] = "target multiplier out of range";
   cases[3][0] = "\"schema_version\":3";              cases[3][1] = "\"schema_version\":99";         cases[3][2] = "wrong schema";
   cases[4][0] = "\"timeout_action\":\"CLOSE_ALL\"";  cases[4][1] = "\"timeout_action\":\"HOLD\"";   cases[4][2] = "bad timeout action";
   cases[5][0] = "\"entry_mode\":\"market_confirmed\""; cases[5][1] = "\"entry_mode\":\"fvg_50\"";   cases[5][2] = "old pending entry mode refused";
   cases[6][0] = "\"minimum_confirmations\":3";       cases[6][1] = "\"minimum_confirmations\":9";   cases[6][2] = "more confirmations than indicators";
   for(int i = 0; i < 7; i++)
     {
      string mutated = resp;
      int hits = StringReplace(mutated, cases[i][0], cases[i][1]);
      Check(hits > 0, "mutation applies: " + cases[i][2]);
      TB_Json mj;
      TB_Runtime mrt;
      string merr = "";
      bool accepted = mj.Parse(mutated) && TB_RuntimeFromJson(mj, "config.", mrt, merr) && TB_RuntimeValidate(mrt, mj, "config.", merr);
      Check(!accepted, "must be rejected: " + cases[i][2]);
     }
   string missing = resp;
   StringReplace(missing, "\"target_multiplier\"", "\"target_multiplierx\"");
   TB_Json pj;
   TB_Runtime prt;
   string perr = "";
   Check(pj.Parse(missing) && !TB_RuntimeFromJson(pj, "config.", prt, perr) && StringFind(perr, "missing") >= 0, "partial config refused (missing path)");

   // ---- event queue
   g_tb_nevents = 0;
   TB_QueueEvent("TEST_EVENT", "\"x\":1");
   Check(g_tb_nevents == 1 && StringFind(g_tb_events[0], "\"type\":\"TEST_EVENT\"") > 0 && StringFind(g_tb_events[0], "\"event_id\":\"") > 0, "event queued");
   TB_Json ej;
   Check(ej.Parse(g_tb_events[0]), "queued event is valid JSON");
   TB_QueueEvent("TEST_EVENT", "");
   Check(g_tb_event_counter >= 2 && g_tb_events[0] != g_tb_events[1], "event ids are unique");
   CheckS(TB_Esc("a\"b\\c"), "a\\\"b\\\\c", "escape");
   CheckS(TB_AssetClass("XAUUSDm"), "metals", "asset class gold");
   CheckS(TB_AssetClass("EURUSD"), "forex", "asset class forex");
   CheckS(TB_AssetClass("BTCUSDm"), "crypto", "asset class crypto");
   CheckS(TB_AssetClass("US30"), "other", "asset class other");

   Print(g_fail == 0 ? "TrendBotComm tests: ALL PASSED" : "TrendBotComm tests: FAILURES = " + IntegerToString(g_fail));
  }
