# Copy this file to ".env" (same folder as run_server.py's parent, i.e. the project folder) and fill it in.
# NEVER share the filled-in file, upload it, or paste its contents anywhere.
TB_EA_SECRET=a-long-random-string-of-40-or-more-characters
TB_DB_PATH=trendbot.db
TB_HOST=127.0.0.1
TB_PORT=8000
# Dashboard/API bearer token (recommended). Without it the /api dashboard stays DISABLED (fail safe).
TB_DASHBOARD_TOKEN=generate-a-long-random-token-for-the-dashboard
# OPTIONAL: Telegram notifications only. The bot runs fully without these - all control
# (start/stop/activate/pause/accounts/settings/trading) happens in the dashboard.
TB_TELEGRAM_TOKEN=paste-the-token-from-BotFather-here
TB_TELEGRAM_USERS=your-numeric-telegram-id
